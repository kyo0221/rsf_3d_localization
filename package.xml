<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rsf_3d_localization</name>
  <version>0.1.0</version>
  <description>Lightweight 3D localization on a point cloud map fusing IMU, odometry, RTK GNSS and NDT scan matching in an error-state Kalman filter</description>
  <maintainer email="s23c1036dv@chibatech.ac.jp">kyo</maintainer>
  <license>Apache-2.0</license>
  <author email="s23c1036dv@chibatech.ac.jp">kyo</author>

  <buildtool_depend>ament_cmake_auto</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

<launch>
  <arg name="param_file" default="$(find-pkg-share rsf_3d_localization)/config/rsf_3d_localization.param.yaml"/>
  <arg name="map_path" default=""/>
  <arg name="use_sim_time" default="false"/>
  <arg name="input_pointcloud" default="/rsf/hokuyo_cloud2"/>
  <arg name="input_imu" default="/rsf/imu"/>
  <arg name="input_gnss" default="/rsf/nav_sat_fix"/>
  <arg name="odom_frame" default="rsf_odom"/>

  <node pkg="rsf_3d_localization" exec="rsf_3d_localization_node" name="rsf_3d_localization" output="screen">
    <param from="$(var param_file)"/>
    <param name="map_path" value="$(var map_path)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <param name="odom_frame" value="$(var odom_frame)"/>
    <remap from="~/input/pointcloud" to="$(var input_pointcloud)"/>
    <remap from="~/input/imu" to="$(var input_imu)"/>
    <remap from="~/input/gnss" to="$(var input_gnss)"/>
    <remap from="~/input/initialpose" to="/initialpose"/>
    <remap from="~/output/pose_with_covariance" to="/rsf_3d_localization/pose_with_covariance"/>
    <remap from="~/output/pointcloud_map" to="/rsf_3d_localization/pointcloud_map"/>
  </node>
</launch>
